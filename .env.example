# Copy to .env to override docker compose defaults. Everything is optional:
# with no .env the stack runs fully offline on ports 3000 / 8000 / 5433.

# Host ports
WEB_PORT=3000
API_PORT=8000
DB_PORT=5433

# Providers: "local" (offline, deterministic) or "openai" (any OpenAI-compatible API:
# OpenAI, Ollama, vLLM, LM Studio, ...). The embedding model must support the
# `dimensions` parameter (vectors are stored as vector(512)).
EMBEDDING_PROVIDER=local
LLM_PROVIDER=local
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
